# Copy these into Vercel > Project > Settings > Environment Variables. NEVER commit real values.

# Long random text (32+ characters) used to sign login sessions. Generate: openssl rand -base64 48
SESSION_SECRET=

# One-time code used on the very first visit to /admin to create the first owner. Remove or change it afterwards.
SETUP_TOKEN=

# The next four are added automatically when you connect the stores in the Vercel dashboard:
#   Storage > Marketplace > Upstash Redis   -> KV_REST_API_URL, KV_REST_API_TOKEN
#   Storage > Blob                          -> BLOB_READ_WRITE_TOKEN
KV_REST_API_URL=
KV_REST_API_TOKEN=
BLOB_READ_WRITE_TOKEN=

# Optional: public address of the site, used for absolute Open Graph image links.
SITE_URL=https://www.fuemalaysia.com
